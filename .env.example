# Copy to .env locally. Never commit actual credentials.
# Set these as runtime secrets on the production host as well.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Used only by the ingestion worker and the explicit pilot provisioning script.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase's newer server secret key is also supported (either one is enough).
SUPABASE_SECRET_KEY=
# Used by local migration commands only, never by the client portal.
SUPABASE_DB_URL=
APP_ORIGIN=http://localhost:5173
PORTAL_PREVIEW_ENABLED=false
# Production: APP_ORIGIN=https://app.gridubuntu.com (after DNS/hosting setup).

# Private Victron pilot configuration. Read-only API requests only.
VICTRON_VRM_ACCESS_TOKEN=
# Optional if token discovery returns exactly one accessible installation.
VICTRON_VRM_INSTALLATION_ID=
# GridUbuntu node UUID from the pilot provisioning script (not the VRM site ID).
VICTRON_PILOT_NODE_ID=
# Set true ONLY after comparing the mapped readings with the actual VRM dashboard.
VICTRON_MAPPING_VERIFIED=false
# Private scheduler credential; do not use the Victron token here.
INGESTION_SECRET=
